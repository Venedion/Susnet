<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true">

                <TextView
                    android:id="@+id/textConnectedTo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Terhubung ke"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/textSsid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Cafe_WiFi"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/textLastUpdated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Belum diperbarui"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnRefresh"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_refresh"
                android:contentDescription="Refresh"
                app:tint="@color/text_primary" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_status_card_warning"
            android:padding="20dp">

            <ImageView
                android:id="@+id/iconStatus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_alert_triangle"
                android:contentDescription="Ikon status waspada"
                app:tint="@color/text_warning" />

            <TextView
                android:id="@+id/textScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="62"
                android:textSize="34sp"
                android:textStyle="bold"
                android:textColor="@color/text_warning" />

            <TextView
                android:id="@+id/textStatusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Waspada"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_warning" />

            <TextView
                android:id="@+id/textStatusDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="2 tanda tidak biasa terdeteksi"
                android:textSize="13sp"
                android:textColor="@color/text_warning"
                android:gravity="center" />
        </LinearLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:columnCount="2"
            android:rowCount="3">

            <include
                layout="@layout/item_signal_card"
                android:id="@+id/cardBssid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp" />

            <include
                layout="@layout/item_signal_card"
                android:id="@+id/cardTls"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp" />

            <include
                layout="@layout/item_signal_card"
                android:id="@+id/cardSignal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp" />

            <include
                layout="@layout/item_signal_card"
                android:id="@+id/cardLatency"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp" />

            <include
                layout="@layout/item_signal_card"
                android:id="@+id/cardArp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnSpan="2"
                android:layout_columnWeight="1"
                android:layout_margin="5dp" />
        </GridLayout>

        <Button
            android:id="@+id/buttonDetail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Lihat penjelasan lengkap"
            android:textSize="15sp"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>