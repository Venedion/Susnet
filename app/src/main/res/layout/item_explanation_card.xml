<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/surface_card_border"
    app:cardBackgroundColor="@color/surface_card"
    android:clipToPadding="false"
    android:clipChildren="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Accent Stripe 4dp (Visible on Changed/Abnormal) -->
        <View
            android:id="@+id/stripeAccent"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/waspada_accent"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header Row: Tile Icon, Label, Chip, Arrow -->
            <LinearLayout
                android:id="@+id/layoutCardHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/iconExplainTile"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_card_bssid"
                    android:contentDescription="@null"
                    app:tint="@color/text_primary" />

                <TextView
                    android:id="@+id/textExplainLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="8dp"
                    tools:text="Alamat WiFi"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <LinearLayout
                    android:id="@+id/layoutStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_status_badge_pill"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp">

                    <ImageView
                        android:id="@+id/iconExplainStatus"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_status_normal"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/textExplainStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        tools:text="Normal"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_success" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iconArrowExpand"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_chevron_down"
                    android:contentDescription="Buka detail"
                    app:tint="@color/text_secondary" />

            </LinearLayout>

            <!-- Expandable Content Area -->
            <LinearLayout
                android:id="@+id/layoutExpandableContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textExplainDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    tools:text="Penjelasan detail sinyal akan muncul di sini."
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/text_secondary" />

                <!-- Box YANG TERDETEKSI -->
                <LinearLayout
                    android:id="@+id/layoutDetectedDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_detected_box"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YANG TERDETEKSI"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/textDetectedContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        tools:text="BSSID sebelumnya: AA:BB:CC:11:22:33\nBSSID sekarang: DD:EE:FF:44:55:66"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <!-- Box KEMUNGKINAN PENYEBAB -->
                <LinearLayout
                    android:id="@+id/layoutPossibleCauses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KEMUNGKINAN PENYEBAB"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/textPossibleCausesContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        tools:text="• Jaringan tiruan dengan nama yang sama\n• Router atau repeater lain milik jaringan yang sama"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
