<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_signal_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iconExplainLeading"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_router"
            android:contentDescription="@null"
            app:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/textExplainLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Alamat wifi"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <ImageView
            android:id="@+id/iconExplainStatus"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_check_circle"
            android:contentDescription="@null"
            app:tint="@color/text_success" />

        <TextView
            android:id="@+id/textExplainStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Normal"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_success" />
    </LinearLayout>

    <TextView
        android:id="@+id/textExplainDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Penjelasan akan muncul di sini."
        android:textSize="13sp"
        android:textColor="@color/text_secondary" />

</LinearLayout>
